+        cf = fl & MMIO_X86_CF;
+    fl &= ~(uint64_t)(MMIO_X86_CF | MMIO_X86_PF | MMIO_X86_AF
+                      | MMIO_X86_ZF | MMIO_X86_SF | MMIO_X86_OF);
