+    if (ev && ev->type != SDL_CONTROLLERDEVICEADDED
+            && ev->type != SDL_CONTROLLERDEVICEREMOVED
+            && ev->type != SDL_JOYDEVICEADDED && ev->type != SDL_JOYDEVICEREMOVED)
+        return;
+    SDL_LockJoysticks();
+    refresh_controllers_locked();
+    SDL_UnlockJoysticks();
+}
