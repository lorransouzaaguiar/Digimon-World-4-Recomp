+/* ── ALU forms on a memory operand (DW4 port) ────────────────────────────
+ *
+ * A compiler folds the load into the operation: `test dword [mmio], imm`,
+ * `or [mmio], reg`, `cmp reg, [mmio]`. Lifted XDK DirectSound does exactly
+ * that against the APU at -O1 (F7 84 03 ...: TEST r/m32, imm32 at guest
+ * 0x002EDEFF), so MOV-only decoding faulted on the first register it tested.
+ * The result has to reach EFLAGS too -- the next instruction is the jcc. */
+#define MMIO_X86_CF 0x001u
+#define MMIO_X86_PF 0x004u
+#define MMIO_X86_AF 0x010u
+#define MMIO_X86_ZF 0x040u
+#define MMIO_X86_SF 0x080u
+#define MMIO_X86_OF 0x800u
+
+enum { MMIO_ALU_ADD, MMIO_ALU_OR, MMIO_ALU_ADC, MMIO_ALU_SBB,
+       MMIO_ALU_AND, MMIO_ALU_SUB, MMIO_ALU_XOR, MMIO_ALU_CMP,
+       MMIO_ALU_TEST, MMIO_ALU_INC, MMIO_ALU_DEC, MMIO_ALU_NEG };
+
+/* a OP b at `size` bytes; updates EFLAGS in the context, returns the result. */
+static inline uint64_t mmio_x86_alu(mmio_ctx_t *uc, int alu, uint64_t a,
+                                    uint64_t b, int size)
+{
+    uint64_t mask = mmio_x86_size_mask(size);
+    uint64_t sign = 1ULL << (size * 8 - 1);
+    uint64_t fl = (uint64_t)uc->uc_mcontext.gregs[REG_EFL];
+    uint64_t cin = fl & MMIO_X86_CF, r, keep_cf = 0;
+    uint64_t cf = 0, of = 0, af = 0;
+    int i, parity = 0;
+
+    a &= mask;
+    b &= mask;
+    switch (alu) {
+    case MMIO_ALU_INC:
+        b = 1; keep_cf = 1; cin = 0;
+        /* fall through */
+    case MMIO_ALU_ADD:
+        if (alu == MMIO_ALU_ADD) cin = 0;
+        /* fall through */
+    case MMIO_ALU_ADC: {
+        unsigned __int128 full = (unsigned __int128)a + b + cin;
+        r = (uint64_t)full & mask;
+        cf = (uint64_t)(full >> (size * 8)) & 1;
+        of = (~(a ^ b) & (a ^ r)) & sign;
+        af = (a ^ b ^ r) & 0x10;
+        break;
+    }
+    case MMIO_ALU_NEG:
+        b = a; a = 0; cin = 0;
+        goto subtract;
+    case MMIO_ALU_DEC:
+        b = 1; keep_cf = 1; cin = 0;
+        goto subtract;
+    case MMIO_ALU_SUB:
+    case MMIO_ALU_CMP:
+        cin = 0;
+        /* fall through */
+    case MMIO_ALU_SBB:
+    subtract:
+        r = (a - b - cin) & mask;
+        cf = (unsigned __int128)a < (unsigned __int128)b + cin;
+        of = ((a ^ b) & (a ^ r)) & sign;
+        af = (a ^ b ^ r) & 0x10;
+        break;
+    case MMIO_ALU_OR:
+        r = a | b;
+        break;
+    case MMIO_ALU_XOR:
+        r = a ^ b;
+        break;
+    default:                                    /* AND, TEST */
+        r = a & b;
+        break;
+    }
