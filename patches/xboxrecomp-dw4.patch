+    if (!parity)   fl |= MMIO_X86_PF;
+    if (af)        fl |= MMIO_X86_AF;
+    if (!r)        fl |= MMIO_X86_ZF;
+    if (r & sign)  fl |= MMIO_X86_SF;
+    if (of)        fl |= MMIO_X86_OF;
+    uc->uc_mcontext.gregs[REG_EFL] = (greg_t)fl;
+    return r;
